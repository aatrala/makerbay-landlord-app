{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "wrangler dev",
    "build": "tsc --noEmit && wrangler deploy --dry-run --outdir dist-worker",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "start": "tsx src/index.ts",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.6",
    "@rentlite/shared": "workspace:*",
    "better-auth": "^1.2.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "openai": "^7.15.0",
    "postgres": "^3.4.0",
    "resend": "^4.1.0",
    "stripe": "^22.6.2",
    "tsx": "^4.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.1"
  }
}
